  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Dark screen action; use for Apply filters. Preview demonstrates CSS states; navigation and data behavior remain in the application.",
      "html": "<button class=\"ds-primary\" type=\"button\">Apply filters</button>",
      "css": ".ds-primary {font-family:\"Pixelify Sans\",sans-serif;font-size:14px;border:1px solid var(--screen-outline,#09607a);border-radius:4px;min-height:44px;padding:8px 12px;cursor:pointer;text-shadow:none;background:var(--screen-field,#0b536c);color:var(--screen-on-field,#e1fdff);} .ds-primary:hover {background:var(--screen-field-hover,#09607a);} .ds-primary:focus-visible {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Pale screen action; use for Cancel and filter editing.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-secondary {font-family:\"Pixelify Sans\",sans-serif;font-size:14px;border:1px solid var(--screen-outline,#09607a);border-radius:4px;min-height:44px;padding:8px 12px;cursor:pointer;text-shadow:none;background:var(--screen-panel,rgb(225 253 255 / .2));color:var(--screen-ink,#063e51);} .ds-secondary:hover {background:var(--screen-hover,rgb(225 253 255 / .4));} .ds-secondary:focus-visible {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;}"
    },
    {
      "name": "Inset search",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Dark input with a cut-in bezel. Static preview; the application uses React Aria and a separate clear button.",
      "html": "<label class=\"ds-search-label\">Find your favorite Pokémon<input class=\"ds-search\" type=\"search\" placeholder=\"e.g. Bulbasaur\"></label>",
      "css": ".ds-search-label {font-family:\"Pixelify Sans\",sans-serif;display:grid;gap:8px;color:var(--screen-ink,#063e51);font-size:14px;} .ds-search {font-family:\"Pixelify Sans\",sans-serif;font-size:16px;min-width:0;min-height:52px;border:1px solid var(--screen-ink,#063e51);border-radius:4px;padding:0 14px;background:var(--screen-field,#0b536c);color:var(--screen-on-field,#e1fdff);box-shadow:inset 0 3px 6px rgb(0 30 44 / .4),inset 0 -1px 0 rgb(225 253 255 / .22);} .ds-search::placeholder {color:#b5dce6;opacity:1;} .ds-search:focus-visible {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;}"
    },
    {
      "name": "Hardware navigation",
      "kind": "nav",
      "refersTo": "hardware-navigation",
      "description": "Raised cobalt navigation button, inset on the short desktop control wing whose top aligns with the outer screen bezel. On compact viewports the same links fill five equal columns above the screen, with the row edges aligned to the outer bezel.",
      "html": "<a class=\"ds-nav\" href=\"#home\" aria-label=\"Home\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v11H3Z M9 21v-8h6v8\"/></svg></a>",
      "css": ".ds-nav {display:grid;place-items:center;width:64px;height:64px;border-radius:6px;background:var(--color-pokedex-button-blue,#176bc6);color:white;box-shadow:inset 0 2px 2px rgb(255 255 255 / .18),0 9px 0 var(--color-pokedex-button-blue-edge,#0b3f86),0 14px 16px rgb(0 0 0 / .28);transition:translate 160ms cubic-bezier(.2,0,0,1),box-shadow 160ms cubic-bezier(.2,0,0,1);} .ds-nav:hover,.ds-nav:focus-visible {translate:0 3px;} .ds-nav:focus-visible {outline:3px solid white;outline-offset:4px;} .ds-nav:active,.ds-nav[aria-current=\"page\"] {translate:0 5px;box-shadow:inset 0 4px 7px rgb(0 0 0 / .32),inset 0 -1px 2px rgb(255 255 255 / .12),0 4px 0 var(--color-pokedex-button-blue-edge,#0b3f86),0 4px 8px rgb(0 0 0 / .2);}"
    },
    {
      "name": "Hardware Settings",
      "kind": "nav",
      "refersTo": "hardware-settings",
      "description": "Yellow Settings variant on the control wing, with dark ink and a 30px cog for optical balance against the other 28px icons. Shares the depressed current-page state and compact navigation row.",
      "html": "<a class=\"ds-settings\" href=\"#settings\" aria-label=\"Settings\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></a>",
      "css": ".ds-settings {display:grid;place-items:center;width:64px;height:64px;border-radius:6px;background:var(--color-pokedex-button-yellow,#f4be38);color:var(--color-pokedex-button-yellow-ink,#3a2b12);box-shadow:inset 0 2px 2px rgb(255 255 255 / .18),0 9px 0 var(--color-pokedex-button-yellow-edge,#b47616),0 14px 16px rgb(0 0 0 / .28);transition:translate 160ms cubic-bezier(.2,0,0,1),box-shadow 160ms cubic-bezier(.2,0,0,1);} .ds-settings:hover,.ds-settings:focus-visible {translate:0 3px;} .ds-settings:focus-visible {outline:3px solid white;outline-offset:4px;} .ds-settings:active,.ds-settings[aria-current=\"page\"] {translate:0 5px;box-shadow:inset 0 4px 7px rgb(0 0 0 / .32),inset 0 -1px 2px rgb(255 255 255 / .12),0 4px 0 var(--color-pokedex-button-yellow-edge,#b47616),0 4px 8px rgb(0 0 0 / .2);}"
    },
    {
      "name": "Database cell",
      "kind": "card",
      "refersTo": "database-cell",
      "description": "Flat grid cell, not a floating card. The labeled artwork space is a preview placeholder; production renders the real Pokémon image.",
      "html": "<a class=\"ds-cell\" href=\"#bulbasaur\"><span class=\"ds-index\" aria-hidden=\"true\">#0001</span><span class=\"ds-art\" aria-hidden=\"true\">Artwork preview</span><span>Bulbasaur</span><span class=\"ds-cell-types\">Grass · Poison</span></a>",
      "css": ".ds-cell {font-family:\"Pixelify Sans\",sans-serif;position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;min-height:164px;width:180px;padding:12px;border:1px solid var(--screen-rule,rgb(225 253 255 / .52));background:var(--screen-panel,rgb(6 132 174 / .2));color:var(--screen-ink,#063e51);font-size:16px;text-align:center;text-decoration:none;transition:scale 160ms cubic-bezier(.2,0,0,1),background-color 160ms cubic-bezier(.2,0,0,1);} .ds-index {position:absolute;top:8px;left:10px;font-size:10px;letter-spacing:.04em;font-variant-numeric:tabular-nums;} .ds-art {display:grid;place-items:center;width:88px;height:88px;font-size:10px;} .ds-cell-types {font-size:12px;} .ds-cell:hover,.ds-cell:focus-visible {background:var(--screen-hover,rgb(225 253 255 / .2));} .ds-cell:focus-visible {outline:2px solid var(--screen-ink,#063e51);outline-offset:-4px;} .ds-cell:active {scale:.96;} @media(prefers-reduced-motion:reduce){.ds-cell{transition:none;}}"
    },
    {
      "name": "Filter option",
      "kind": "chip",
      "refersTo": "filter-option",
      "description": "Native checkbox preview of the selected palette and check indicator. Application behavior uses the React Aria Checkbox.",
      "html": "<label class=\"ds-filter\"><input type=\"checkbox\" checked><span>Gen I</span></label>",
      "css": ".ds-filter {font-family:\"Pixelify Sans\",sans-serif;position:relative;display:flex;align-items:center;gap:8px;cursor:pointer;min-height:44px;padding:8px;border:1px solid var(--screen-outline,rgb(6 62 81 / .6));border-radius:4px;background:var(--screen-panel,rgb(225 253 255 / .16));color:var(--screen-ink,#063e51);font-size:14px;} .ds-filter:has(input:checked) {background:var(--screen-field,#0b536c);color:var(--screen-on-field,#e1fdff);} .ds-filter input {accent-color:var(--screen-field,#0b536c);width:16px;height:16px;} .ds-filter:hover:not(:has(input:checked)) {background:var(--screen-hover,rgb(225 253 255 / .3));} .ds-filter:focus-within {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;}"
    },
    {
      "name": "Settings switch",
      "kind": "custom",
      "refersTo": "settings-switch",
      "description": "52 × 28px track in a 44px-minimum label. Native input preview; application uses React Aria Switch and a described supporting paragraph.",
      "html": "<label class=\"ds-switch\"><span>Enhance contrast</span><input type=\"checkbox\" role=\"switch\"><span class=\"ds-track\" aria-hidden=\"true\"><span></span></span></label>",
      "css": ".ds-switch {font-family:\"Pixelify Sans\",sans-serif;display:flex;position:relative;align-items:center;justify-content:space-between;gap:16px;min-height:44px;color:var(--screen-ink,#063e51);cursor:pointer;} .ds-switch input {position:absolute;width:1px;height:1px;opacity:0;} .ds-switch:has(input:focus-visible) {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;} .ds-track {display:flex;align-items:center;flex-shrink:0;width:52px;height:28px;padding:3px;box-sizing:border-box;border:1px solid var(--screen-outline,#09607a);border-radius:16px;background:var(--screen-switch-off,rgb(6 62 81 / .14));} .ds-track span {display:block;flex-shrink:0;width:20px;height:20px;border-radius:50%;background:var(--screen-on-field,#e1fdff);transition:translate 160ms cubic-bezier(.2,0,0,1);} .ds-switch input:checked + .ds-track {background:var(--screen-field,#0b536c);} .ds-switch input:checked + .ds-track span {translate:24px 0;} @media(prefers-reduced-motion:reduce){.ds-track span{transition:none;}}"
    },
    {
      "name": "Cry control",
      "kind": "custom",
      "refersTo": "cry-player",
      "description": "Labeled replay control with decorative meter. Static preview has no audio; the application connects its bars to AudioContext frequency data.",
      "html": "<button class=\"ds-cry\" type=\"button\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 2v12l10-6Z\"/></svg><span>Play cry</span><span class=\"ds-meter\" aria-hidden=\"true\">▁▃▆▂▅▇▃▁▅▂▆▃</span></button>",
      "css": ".ds-cry {font-family:\"Pixelify Sans\",sans-serif;display:flex;align-items:center;gap:10px;border:1px solid var(--screen-outline,rgb(6 62 81 / .5));border-radius:2px;background:var(--screen-panel,rgb(225 253 255 / .12));padding:8px 12px;min-height:44px;color:var(--screen-ink,#063e51);font-size:14px;cursor:pointer;} .ds-meter {margin-left:4px;letter-spacing:2px;} .ds-cry:hover {background:var(--screen-hover,rgb(225 253 255 / .28));} .ds-cry:focus-visible {outline:2px solid var(--screen-ink,#063e51);outline-offset:3px;}"
    },
    {
      "name": "Clear type label",
      "kind": "chip",
      "refersTo": "type-label-clear",
      "description": "Text alternative shown in enhanced contrast. Normal mode uses the existing type badge bitmap.",
      "html": "<span class=\"ds-type\">Grass</span>",
      "css": ".ds-type {font-family:\"Pixelify Sans\",sans-serif;display:inline-block;border:1px solid #315f70;border-radius:4px;background:#d6f1f7;color:#042a3a;padding:2px 6px;font-size:14px;font-weight:600;line-height:1.25;}"
    }
  ],
  "narrative": {
    "northStar": "The Handheld Pokédex",
    "overview": "A playful physical instrument surrounds a precise digital field guide. The red casing, lens, status lights, and depressed navigation buttons establish the handheld identity. Inside it, Pokémon and their records belong to one continuous blue display: a compact database that feels recognizable from the games.\n\nThe interface is expressive through its materials and Pixelify Sans typography. Screen content uses fine rules, restrained translucent fills, and clear alignment. Enhanced contrast keeps the same structure and blue character while replacing texture and translucent layers with solid, readable surfaces.",
    "keyCharacteristics": [
      "Tactile hardware around flat screen content.",
      "A cyan database grid with clear records and game-inspired labels.",
      "One pixel font, compact spacing, and deliberate data hierarchy.",
      "A quieter, solid blue alternative through enhanced contrast.",
      "Brief, optional Pokémon motion and user-controlled sound."
    ],
    "rules": [
      {
        "name": "The Screen Roles Rule",
        "body": "New screen controls must read the existing `--screen-*` roles with appropriate normal-mode fallbacks. A normal-mode color alone is insufficient when the component has an enhanced-contrast state.",
        "section": "colors"
      },
      {
        "name": "The One Font Rule",
        "body": "Keep Pixelify Sans throughout the interface. Establish hierarchy through size, spacing, case, and alignment before adding weight or a second typeface.",
        "section": "typography"
      },
      {
        "name": "The Hardware Depth Rule",
        "body": "Reserve substantial elevation for the enclosure and physical navigation. Keep records integrated into the screen rather than turning them into glass tiles.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the same screen height and responsive navigation position on every route.",
      "Do use thin shared rules and tonal fills for database content.",
      "Do support both screen palettes through semantic screen roles.",
      "Do retain visible keyboard focus, native semantics, and explicit selected states.",
      "Do preserve the chosen bounce while honoring its motion preferences.",
      "Do keep empty, loading, error, and missing-data messages honest and useful.",
      "Do update this file and `.impeccable/design.json` together after approved style changes."
    ],
    "donts": [
      "Don't add glass cards, floating panel shadows, or overview sprite pedestals.",
      "Don't use hardware red as another screen action color.",
      "Don't turn the decorative cry meter into a claim of real waveform analysis.",
      "Don't hide meaningful type information behind color or an image alone in enhanced contrast.",
      "Don't replace the approved font or detail bounce during generic cleanup.",
      "Don't treat this style guide or a consistency audit as proof of full WCAG conformance."
    ]
  }
}
