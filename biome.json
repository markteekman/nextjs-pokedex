{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "preset": "none",
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
